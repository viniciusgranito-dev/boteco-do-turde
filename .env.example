# =====================================================================
# Boteco do Turde — Reservas
# Copie este arquivo para ".env.local" e preencha com os seus valores.
# Nunca comite o .env.local.
# =====================================================================

# --- Supabase --------------------------------------------------------
# Painel do Supabase > Project Settings > Data API
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# "anon public" — pode aparecer no navegador, é protegida pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Site ------------------------------------------------------------
# Endereço final do site, usado para montar o link pessoal da reserva
# que vai na mensagem de WhatsApp. Em produção: https://seu-projeto.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =====================================================================
# Só para rodar os testes de integração do banco (opcional).
# Com o Supabase CLI local, o valor costuma ser exatamente este:
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# =====================================================================
# TEST_DATABASE_URL=
